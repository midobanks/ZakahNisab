# Database — PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/zakahnisab"

# Stripe (donations)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Exchange Rate API (Frankfurter — free, no API key required)
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v2
EXCHANGE_RATE_BASE_CURRENCY=USD
EXCHANGE_RATE_REFRESH_CRON=0 2 * * *
EXCHANGE_RATE_CACHE_TTL_HOURS=24

# Precious Metals API (MetalpriceAPI — primary)
METAL_API_PROVIDER=metalpriceapi
METALPRICE_API_KEY="your_metalprice_api_key"

# Precious Metals Fallback API (Metals-API)
METALS_API_KEY="your_metals_api_key_if_using_fallback"

# Base currency for stored canonical metal prices
METAL_PRICE_BASE_CURRENCY=USD

# Refresh settings
METAL_PRICE_REFRESH_CRON=0 */6 * * *
METAL_PRICE_MAX_STALE_HOURS=24

# Hijri Calendar
HIJRI_CALENDAR_PROVIDER=aladhan
HIJRI_DEFAULT_ADJUSTMENT=0
HIJRI_DEFAULT_METHOD=calculated
