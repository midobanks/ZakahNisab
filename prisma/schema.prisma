generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model EmailSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model PriceCache {
  id            String   @id @default(cuid())
  currency      String
  goldPrice     Float
  silverPrice   Float
  exchangeRate  Float
  lastUpdatedAt DateTime @updatedAt

  @@unique([currency])
}

model MetalPrice {
  id                      String    @id @default(cuid())
  provider                String
  baseCurrency            String    @default("USD")
  goldPricePerTroyOunce   Float
  silverPricePerTroyOunce Float
  goldPricePerGram        Float
  silverPricePerGram      Float
  sourceTimestamp         DateTime?
  fetchedAt               DateTime  @default(now())
  status                  String    @default("live")
  rawResponse             Json?
  createdAt               DateTime  @default(now())

  @@index([fetchedAt(sort: Desc)])
  @@index([provider])
}

model ExchangeRate {
  id                String    @id @default(cuid())
  baseCurrency      String
  targetCurrency    String
  rate              Float
  provider          String
  providerUpdatedAt DateTime?
  fetchedAt         DateTime  @default(now())
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([baseCurrency, targetCurrency, fetchedAt])
}

model ApiRefreshLog {
  id          String    @id @default(cuid())
  service     String
  provider    String
  status      String
  message     String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  metadata    Json?
}
